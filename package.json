{
  "name": "react-vite-foundation",
  "version": "0.12.0",
  "description": "Auth-aware API client, local/prod URL switch, query-key factory, and generated-TS-types CLI for a React + Vite + TanStack Query frontend, plus SEO head-tag management and a build-time SSG prerenderer.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "gen-types": "./bin/gen-types.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "json-schema-to-typescript": "^15.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@radix-ui/themes": "^3.2.0",
    "@radix-ui/react-icons": "^1.3.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./seo": "./src/seo.ts",
    "./prerender": "./src/prerender.ts",
    "./auth-ui": "./src/authUi.tsx"
  },
  "peerDependencies": {
    "react": ">=18",
    "@radix-ui/themes": ">=3",
    "@radix-ui/react-icons": ">=1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@radix-ui/themes": {
      "optional": true
    },
    "@radix-ui/react-icons": {
      "optional": true
    }
  }
}
